# Copie para tools/cloudfy/.env.local. Não coloque credenciais no frontend.
# Sem usuário/senha, faça login na janela aberta na primeira execução.
CLOUDFY_USERNAME=
CLOUDFY_PASSWORD=
ESCRITORIO_EMAIL=
ESCRITORIO_PASSWORD=
# O BAT cria servidor, porta e token temporários automaticamente.
# URL direta do relatório, se conhecida; senão usa os menus.
CLOUDFY_REPORT_URL=
# Conforme o relatório que deseja importar. O print enviado usa Por data.
CLOUDFY_REPORT_TYPE=Por data
# Seletores opcionais, caso os campos não tenham rótulos acessíveis.
# Podem apontar para campos dentro de um iframe do relatório.
CLOUDFY_START_SELECTOR=
CLOUDFY_END_SELECTOR=
CLOUDFY_TYPE_SELECTOR=
CLOUDFY_CSV_SELECTOR=
