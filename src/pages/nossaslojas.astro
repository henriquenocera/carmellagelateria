---
import BaseHead from '../layout/BaseHead.astro'
import BaseBody from '../layout/BaseBody.astro'

import '../styles/pages/index.scss'
import '../styles/pages/lojas.scss'



const title = "Nossas lojas | Carmella Gelateria Artigianale"
const description = `Encontre uma unidade Carmella Gelateria e confira nossos horários de funcionamento.`
const url = "https://www.carmellagelateria.com.br/nossaslojas"
---


<html lang="pt-BR">
<BaseHead title={title} description={description} url={url} />
<BaseBody>

  <main class="pagina-lojas">
    <header class="lojas-intro">
      <p class="lojas-etiqueta">Perto de você</p>
      <h1>Visite uma de nossas lojas</h1>
      <p>Escolha a unidade mais conveniente e venha aproveitar um gelato artesanal.</p>
    </header>

    <section class="lojas-lista" aria-label="Endereços e horários das lojas">
      <article class="loja-card">
        <span class="loja-numero" aria-hidden="true">01</span>
        <h2>Loja Ahu</h2>
        <p class="loja-endereco">Rua Colombo, 183</p>
        <div class="loja-horario">
          <span class="horario-icone" aria-hidden="true">◷</span>
          <p><strong>Todos os dias</strong><br /><time>12h às 19h</time></p>
        </div>
        <a class="loja-rota" href="https://maps.app.goo.gl/sQGPvPWkoKmyyEnJ7" target="_blank" rel="noopener noreferrer">
          Ver rota no Google Maps <span aria-hidden="true">↗</span>
        </a>
      </article>

      <article class="loja-card">
        <span class="loja-numero" aria-hidden="true">02</span>
        <h2>Loja Alto da XV</h2>
        <p class="loja-endereco">Rua Sete de Abril, 934</p>
        <div class="loja-horario">
          <span class="horario-icone" aria-hidden="true">◷</span>
          <p><strong>Todos os dias</strong><br /><time>12h às 19h</time></p>
        </div>
        <a class="loja-rota" href="https://maps.app.goo.gl/MyqbkkQwz1wZDCRT8" target="_blank" rel="noopener noreferrer">
          Ver rota no Google Maps <span aria-hidden="true">↗</span>
        </a>
      </article>
    </section>

    <section class="mapa-lojas" aria-labelledby="mapa-titulo">
      <div class="mapa-cabecalho">
        <div>
          <p class="lojas-etiqueta">Como chegar</p>
          <h2 id="mapa-titulo">Encontre a Carmella</h2>
        </div>
        <p>Veja nossas unidades no mapa e planeje sua visita.</p>
      </div>
      <div class="mapa-container">
        <iframe src="https://www.google.com/maps/d/u/0/embed?mid=1W403tPeepOKoGsfBx6-EBmAEP_RITjo&ehbc=2E312F&noprof=1"
          width="100%" height="480" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          title="Mapa com a localização das lojas Carmella"></iframe>
      </div>
    </section>
  </main>

</BaseBody>

</html>
